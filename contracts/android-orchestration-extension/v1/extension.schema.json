{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akbs:contracts:android-orchestration-extension:v1",
  "title": "Android orchestration extension v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider_id",
    "provider_version",
    "compatible_core_contracts",
    "orchestrator"
  ],
  "properties": {
    "schema": {"const": "android-orchestration-extension-v1"},
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "provider_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "compatible_core_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "contains": {"const": "android-engineering-orchestration-v1"}
    },
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id"],
      "properties": {
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    }
  }
}
