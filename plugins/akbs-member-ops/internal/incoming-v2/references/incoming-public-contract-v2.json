  "duplicate_package_identity": {
    "content_identity": "akbs-directory-payload-sha256-v1",
    "same_file_tree_sha256": {
      "http_status": 200,
      "outcome": "idempotent_replay",
      "creates_new_fact": false
    },
    "different_file_tree_sha256": {
      "http_status": 409,
      "outcome": "reject_conflict",
      "reason_code": "package_already_exists",
      "creates_new_fact": false
    }
  },
  "patch_information_completion": {
    "schema": "akbs-patch-package-information-completion/v1",
    "fields": [
      {"id": "project", "label": "项目"},
      {"id": "projects", "label": "适用项目"},
      {"id": "platform", "label": "平台"},
      {"id": "android_version", "label": "Android 版本"},
      {"id": "title", "label": "标题"},
      {"id": "summary", "label": "功能说明"},
      {"id": "feature_name", "label": "功能名称"},
      {"id": "problem", "label": "问题说明"},
      {"id": "solution", "label": "解决办法"},
      {"id": "result", "label": "验证结果"},
      {"id": "risk_or_gap", "label": "风险或边界"},
      {"id": "code_anchors", "label": "代码位置"},
      {"id": "verification", "label": "验证说明"},
      {"id": "applicability", "label": "适用边界"}
    ],
    "attachment": {
      "max_file_bytes": 2097152,
      "max_total_bytes": 8388608,
      "patch_assets_immutable": true
    }
  },
  "patch_package_contract": {
    "schema": "akbs-patch-package-contract/v2",
    "business_identity": {
      "visible_package_type": "patch_package",
      "identity_field": "patch_package_id",
      "canonical_identity": "patch_packages.patch_package_id",
      "queue_identity": "patch_packages.patch_package_id",
      "main_branch_identity": "patch_packages.patch_package_id",
      "source_identity_field": "package_key",
      "source_identity_authority": "packages.package_key",
      "source_identity_role": "source_only",
      "patch_assets_immutable": true,
      "non_patch_envelope_append_only": true
    },
    "patch_set": {
      "algorithm": "sha256-canonical-json-v1",
      "source": "package_assets[asset_type=patch]",
      "sort": ["relative_path", "sha256"],
      "fields": ["relative_path", "sha256", "size_bytes"]
    },
    "queue": {
      "branch": "queue",
      "states": [
        "received",
        "under_review",
        "information_required",
        "information_review",
        "closed"
      ],
      "transitions": [
        {"from_branch": "queue", "from": "received", "action": "review_started", "to_branch": "queue", "to": "under_review"},
        {"from_branch": "queue", "from": "received", "action": "information_requested", "to_branch": "queue", "to": "information_required"},
        {"from_branch": "queue", "from": "under_review", "action": "information_requested", "to_branch": "queue", "to": "information_required"},
        {"from_branch": "queue", "from": "information_review", "action": "information_requested", "to_branch": "queue", "to": "information_required"},
        {"from_branch": "queue", "from": "information_required", "action": "information_submitted", "to_branch": "queue", "to": "information_review"},
        {"from_branch": "queue", "from": "received", "action": "admitted", "to_branch": "main", "to": "under_review"},
        {"from_branch": "queue", "from": "under_review", "action": "admitted", "to_branch": "main", "to": "under_review"},
        {"from_branch": "queue", "from": "information_review", "action": "admitted", "to_branch": "main", "to": "under_review"},
        {"from_branch": "queue", "from": "received", "action": "rejected", "to_branch": "queue", "to": "closed", "final_decision": "rejected"},
        {"from_branch": "queue", "from": "under_review", "action": "rejected", "to_branch": "queue", "to": "closed", "final_decision": "rejected"},
        {"from_branch": "queue", "from": "information_required", "action": "rejected", "to_branch": "queue", "to": "closed", "final_decision": "rejected"},
        {"from_branch": "queue", "from": "information_review", "action": "rejected", "to_branch": "queue", "to": "closed", "final_decision": "rejected"},
        {"from_branch": "queue", "from": "received", "action": "withdrawn", "to_branch": "queue", "to": "closed", "final_decision": "withdrawn"}
      ],
      "terminal_states": ["closed"],
      "admission_target": {"branch": "main", "stage": "under_review"},
      "rejection_target": {"branch": "queue", "stage": "closed", "final_decision": "rejected"},
      "idempotency": "same-actor-and-key-replays-only-identical-canonical-payload"
    },
    "curation": {
      "branch": "main",
      "stages": ["under_review", "pending_merge_confirmation", "dispute_open", "closed"],
      "allowed_decisions": ["new_case", "merge_existing"],
      "member_actions": ["confirm_merge", "submit_merge_dispute"],
      "forbidden_decisions": ["needs_evidence", "supplement_review"],
      "forbidden_actions": [
        "submit_supplement",
        "close_supplement_chain",
        "upload_replacement_original"
      ]
    },
    "retired_business_fields": [
      "logical_package_key",
      "logical_root_package_key",
      "original_package_key",
      "root_original_package_key",
      "supplement_delta",
      "supplement_for",
      "supplement_for_package_key",
      "supplement_intent",
      "supplement_mode",
      "supplement_package_key",
      "supplement_reason",
      "supplement_task"
    ],
    "retired_business_values": [
      "original_package",
      "supplement_package",
      "logical_package",
      "needs_evidence",
      "supplement_review",
      "close_supplement_chain"
    ],
    "history": {
      "raw_rows": "immutable_audit_only",
      "retired_business_vocabulary": "history_audit_only",
      "public_source_roles": ["source"],
      "missing_parent_projection": "history_compatible_patch_package",
      "inferred_relation_requires_audit_marker": true
    },
    "regenerate_when": [
      "patch_bytes_change",
      "patch_path_change",
      "patch_set_change",
      "functional_split_required"
    ]
  }
}
