{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akbs.internal/contracts/incoming/v2/akbs-android-change-package.schema.json",
  "title": "AKBS Android change package v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "package_kind", "package_status", "identity",
    "subject", "workflow", "components", "sources", "readme", "patches", "evidence"
  ],
  "properties": {
    "schema": {"const": "akbs-android-change-package-v2"},
    "schema_version": {"const": "2"},
    "package_kind": {"const": "android_change"},
    "package_status": {"const": "validated"},
    "identity": {"$ref": "#/$defs/identity"},
    "subject": {"$ref": "#/$defs/subject"},
    "workflow": {"$ref": "#/$defs/workflow"},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "readme": {"$ref": "#/$defs/readme"},
    "patches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/patch"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "token": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "project": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
    "repoPath": {
      "oneOf": [
        {"const": "."},
        {"type": "string", "pattern": "^(?!/)(?!\\.$)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"}
      ]
    },
    "filePath": {"type": "string", "pattern": "^(?!/)(?!\\.$)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/filePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["member_alias", "run_id", "created_at"],
      "properties": {
        "member_alias": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
        "run_id": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{6}(?:-[A-Za-z0-9_.-]+)?$"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "summary", "primary_component_id", "target"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "feature_key": {"type": "string", "minLength": 1, "maxLength": 200},
        "primary_component_id": {"$ref": "#/$defs/id"},
        "target": {
          "type": "object", "additionalProperties": false,
          "required": ["project", "platform", "android_version"],
          "properties": {
            "project": {"$ref": "#/$defs/project"},
            "platform": {"enum": ["mtk", "rk", "unisoc"]},
            "android_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}
          }
        }
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "implementation_origins", "capture_tool"],
      "properties": {
        "contract": {"enum": ["current_codex_skill", "manual_import", "historical_import"]},
        "implementation_origins": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["codex", "manual", "external", "historical", "mixed", "unknown"]}
        },
        "capture_tool": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {"id": {"const": "android-patch-capture"}, "version": {"const": "2"}}
        }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "layer", "type", "partition", "ownership"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "layer": {"enum": ["application", "platform", "native", "hal", "kernel", "device", "build"]},
        "type": {"$ref": "#/$defs/token"},
        "partition": {"$ref": "#/$defs/token"},
        "ownership": {"$ref": "#/$defs/token"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "qualifiers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "repo_path"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["git", "external"]},
        "repo_path": {"$ref": "#/$defs/repoPath"},
        "remote_url": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://[^/]*@)[^?#]+$"},
        "base_revision": {"$ref": "#/$defs/gitOid"},
        "head_revision": {"$ref": "#/$defs/gitOid"},
        "branch": {"type": "string", "minLength": 1, "maxLength": 512},
        "external_reference": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "git"}}},
        "then": {"required": ["base_revision", "head_revision"]},
        "else": {"required": ["external_reference"]}
      }]
    },
    "readme": {
      "allOf": [
        {"$ref": "#/$defs/file"},
        {"type": "object", "properties": {"path": {"const": "README.md"}}}
      ]
    },
    "patch": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "component_ids", "source_id", "path", "sha256", "size_bytes", "format"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "component_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "source_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "pattern": "^patches/[A-Za-z0-9][A-Za-z0-9._@-]*\\.patch$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "format": {"enum": ["git_diff", "git_format_patch", "binary_patch", "file_bundle"]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "component_ids", "path", "sha256", "size_bytes", "scope", "result"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/token"},
        "component_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "path": {"type": "string", "pattern": "^evidence/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "scope": {"enum": ["component", "feature", "package"]},
        "result": {"enum": ["PASS", "WARN", "FAIL", "INFO", "NOT_RUN", "NOT_APPLICABLE"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "not_applicable_basis": {
          "type": "object", "additionalProperties": false,
          "required": ["basis", "limits"],
          "properties": {
            "basis": {"type": "string", "minLength": 1, "maxLength": 2000},
            "limits": {"type": "string", "minLength": 1, "maxLength": 2000}
          }
        }
      }
    }
  }
}
