    },
    "evidence_component_membership_required": true,
    "evidence_sha256_required": true,
    "capture_manifest_sha256_required": true,
    "capture_archive_inventory_sha256_required": true,
    "unknown_fields": "reject"
  },
  "shape_families": {
    "source_integrity": {
      "required_payload_fields": [
        "kind",
        "repositories",
        "modified_files",
        "component_ids"
      ],
      "result": "PASS_when_nonempty_repositories_and_modified_files"
    },
    "diff_facts": {
      "required_payload_fields": [
        "kind",
        "modified_files",
        "component_ids"
      ],
      "result": "INFO_when_nonempty_modified_files"
    },
    "risk": {
      "required_payload_fields": [
        "kind",
        "risk_areas",
        "basis",
        "limits",
        "component_ids"
      ],
      "result": "INFO_when_basis_and_limits_nonempty"
    },
    "policy": {
      "required_payload_fields": [
        "result",
        "errors",
        "component_ids"
      ],
      "result": "PASS_when_result_PASS_and_errors_empty"
    },
    "verification": {
      "required_payload_fields": [
        "result",
        "contract_version",
        "scope",
        "requirement_acceptance",
        "component_ids"
      ],
      "result": "PASS_when_feature_requirement_is_accepted"
    },
    "regression": {
      "required_payload_fields": [
        "result",
        "health_checks",
        "component_ids"
      ],
      "result": "PASS_when_result_PASS_and_health_checks_nonempty"
    },
    "rollback": {
      "required_payload_fields": [
        "kind",
        "plan",
        "component_ids",
        "result"
      ],
      "result": "PASS_when_plan_nonempty"
    },
    "search": {
      "required_payload_fields": [
        "result",
        "searched",
        "decision",
        "component_ids"
      ],
      "result": "PASS_or_INFO_when_search_decision_is_closed"
    },
    "import_provenance": {
      "required_payload_fields": [
        "kind",
        "repository_artifacts",
        "component_ids",
        "result"
      ],
      "result": "PASS_when_every_repository_has_sha256"
    },
    "build": {
      "required_payload_fields": [
        "result",
        "build",
        "component_ids"
      ],
      "result": "PASS_when_result_PASS_and_build_nonempty"
    },
    "runtime": {
      "required_payload_fields": [
        "result",
        "steps",
        "component_ids"
      ],
      "result": "PASS_when_result_PASS_and_steps_nonempty"
    },
    "structured_assertion": {
      "required_payload_fields": [
        "kind",
        "assertions",
        "component_ids",
        "result"
      ],
      "result": "matching_component_and_accepted_assertion_id_only"
    },
    "runtime_or_equivalent": {
      "required_payload_fields": [
        "result",
        "component_ids"
      ],
      "result": "PASS_when_runtime_steps_nonempty_or_explicit_feature_equivalent",
      "equivalent_required_nonempty": [
        "equivalent_type",
        "reason",
        "coverage",
        "remaining_risk"
      ],
      "equivalent_scope": "feature",
      "equivalent_requirement_acceptance": "accepted",
      "equivalent_contract_version": "akbs-verification-evidence/v2"
    }
  },
  "not_applicable": {
    "basis_fields": [
      "basis",
      "limits"
    ],
    "mandatory_groups": [
      "source_integrity",
      "feature_acceptance"
    ],
