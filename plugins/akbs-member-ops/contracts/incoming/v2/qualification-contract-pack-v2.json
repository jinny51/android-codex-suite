    "server_decision_contract": "akbs-server-qualification-decision-v1"
  },
  "capability": {
    "taxonomy_layers": [
      "application",
      "platform",
      "native",
      "hal",
      "kernel",
      "device",
      "build"
    ],
    "executable_layers": [
      "application",
      "platform",
      "native",
      "hal",
      "kernel",
      "device",
      "build"
    ],
