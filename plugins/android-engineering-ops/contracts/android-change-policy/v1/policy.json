{
  "schema": "android-change-policy-v1",
  "policy_id": "android-change-policy",
  "version": "1.0.0",
  "authority": "canonical",
  "scope": {
    "universal": "all_patch_archived_android_changes",
    "component_layers": ["application", "platform", "native", "hal", "kernel", "device", "build"],
    "overlays": {
      "framework": {
        "when": {"layer": "platform", "route": "framework"},
        "legacy_route": "change_domain=framework normalized to platform"
      }
    }
  },
  "attribution": {
    "identity_field": "member_alias",
    "identity_source": "current_member_profile",
    "profile_selection": "explicit_profile_or_configured_default_profile",
    "free_form_identity_override": "forbidden",
    "alias_pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
    "date_format": "yyyyMMdd",
    "opening_template": "//<member_alias> <yyyyMMdd>@{",
    "closing_template": "//<member_alias> <yyyyMMdd>@}",
    "marker_line_shape": "standalone_slash_comment_with_optional_leading_and_trailing_whitespace_only",
    "paired_coverage": "every_nonblank_added_line_in_an_applicable_file_hunk_must_be_inside_a_matching_pair",
    "pair_scope": "one_diff_file_and_one_diff_hunk",
    "direct_marker_applicability": "files_where_slash_line_comments_are_syntactically_valid",
    "other_file_types": "require_a_versioned_comment_style_adapter_before_direct_marker_insertion",
    "generation_owner": "codex",
    "new_codex_changes_require_paired_markers": true,
    "single_line_changes_use_paired_markers": true,
    "forbidden_identity_sources": [
      "hardcoded_example_alias",
      "git_author",
      "invented_alias",
      "secondary_alias_field"
    ],
    "forbidden_synthetic_metadata": [
      "invented_requirement_id",
      "invented_ticket_id"
    ],
    "historical_or_external_changes": "preserve_original_markers_without_rewriting_authorship"
  },
  "profiles": {
    "universal_patch_archive": {
      "mandatory": true,
      "rules": [
        "resolve_member_alias_from_current_member_profile",
        "codex_generates_paired_author_date_markers_during_implementation",
        "do_not_insert_slash_markers_into_files_that_do_not_support_slash_line_comments",
        "do_not_invent_requirement_or_ticket_ids",
        "preserve_original_authorship_for_historical_or_external_changes",
        "capture_and_intake_record_policy_evidence_without_rewriting_source"
      ]
    },
    "framework": {
      "mandatory_when_component": {"layer": "platform", "route": "framework"},
      "rules": [
        "new_logs_use_FrameworkLog_instead_of_direct_Log_or_Slog",
        "persist.sys.framework.debug_switches_are_centralized_in_FrameworkLog.java",
        "user_visible_strings_and_reused_log_templates_use_resources",
        "feature_material_records_logging_properties_localization_and_rollback"
      ]
    },
    "legacy_jinny_style": {
      "mandatory": false,
      "status": "compatibility_advisory",
      "rules": [
        "author_suffix_on_new_helper_method_names",
        "author_suffix_and_Utils_on_extracted_utility_classes"
      ]
    }
  }
}
